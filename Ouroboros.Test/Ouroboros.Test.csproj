<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>

    <!-- xunit v3 test projects self-host their runner, so the project builds as an executable. -->
    <OutputType>Exe</OutputType>

    <!-- The Responses surface is [Experimental("OPENAI001")], and the stub transports build a real
         ResponsesClient on purpose - a fake shaped differently from the client OuroClient builds
         would prove nothing about it. Same suppression as Ouroboros.csproj, same reason. -->
    <NoWarn>$(NoWarn);OPENAI001</NoWarn>

    <!-- xUnit1051 wants every CancellationToken-accepting call in a test to pass
         TestContext.Current.CancellationToken. It is advisory, it fires ~48 times across the suite,
         and none of these tests are long enough for cancellation responsiveness to matter. Worth
         doing as its own pass rather than inside the v2-to-v3 migration. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Templates\TestFragment.md" />
    <None Remove="Templates\TestTemplate.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\TestFragment.md" />
    <EmbeddedResource Include="Templates\TestTemplate.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ouroboros\Ouroboros.csproj" />
  </ItemGroup>

</Project>
