<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>

		<!-- Split so the suffix can be cleared without editing this file:
		       prerelease   dotnet pack
		       stable       dotnet pack -p:VersionSuffix=
		     Anything in VersionSuffix makes NuGet treat the package as prerelease.
		     AssemblyVersion stays 5.0.0.0 across all of them, so moving beta.1 -> beta.2 -> 5.0.0
		     does not churn assembly binding. -->
		<VersionPrefix>5.0.0</VersionPrefix>
		<VersionSuffix>beta.2</VersionSuffix>

		<!-- The entire OpenAI.Responses and OpenAI.Containers surface is [Experimental("OPENAI001")].
		     Suppressed here rather than at call sites because it is unavoidable - there is no
		     non-experimental way to reach the Responses API - and because the SDK stays behind
		     IChatProvider, so the diagnostic never reaches a consumer of this package. -->
		<NoWarn>$(NoWarn);OPENAI001</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Identity -->
		<PackageId>OuroborosAI.Core</PackageId>
		<Authors>Brian MacKay</Authors>

		<!-- Legal -->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Brian MacKay 2022-2026</Copyright> 

		<!-- Location -->
		<PackageProjectUrl>https://github.com/kinetiq/Ouroboros</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kinetiq/Ouroboros</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		
		<!-- Release -->
		<Description>
			Powerful layer on top of OpenAI supporting chaining and recursion scenarios. Includes fluent SDK for chaining, templates, structured output, and text processing. .NET 10 only.
		</Description>
		<PackageReleaseNotes>
			Prerelease. beta.2 adds Anthropic as a second provider: Claude models route through the same client via the OuroborosOptions overload of AddOuroboros. Claude requests can opt into server-side code execution (OuroServerTools.CodeExecution) - results arrive as OuroCodeExecutionBlock entries with stdout, exit code and generated-file references - and file I/O via UploadFileAsync / DownloadFileAsync / DeleteFileAsync plus ChatOptions.Attachments. Responses now carry typed content blocks and an OuroStopReason (truncation and paused tool loops are finally visible). Adds per-attempt timeouts (ChatOptions.Timeout), CancellationToken support, and a retry policy that no longer retries timeouts. A throwing OnChatCompleted hook no longer fails the chat it was logging - see OnChatCompletedFailure. ChatAsync no longer mutates the caller's ChatOptions. 5.0.0 is a breaking release that removes the provider SDK from the public API; see MIGRATION_4.4_to_5.0.md.
		</PackageReleaseNotes>
		<PackageTags>gpt llm openai chatgpt anthropic claude code-interpreter c#</PackageTags>
		<Title>Ouroboros</Title>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="" />
		<PackageReference Include="Anthropic" Version="12.39.0" />
		<!-- Pinned to override the vulnerable 9.0.4 that Microsoft.ML.Tokenizers.Data.O200kBase
		     pulls in transitively (GHSA-73j8-2gch-69rq). Safe to drop once that package ships
		     against a patched version. -->
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
		<PackageReference Include="OpenAI" Version="2.12.0" />
		<PackageReference Include="Polly" Version="8.7.0" />
		<PackageReference Include="Polly.Contrib.WaitAndRetry" Version="1.1.1" />
		<PackageReference Include="Scriban" Version="7.2.5" />
		<PackageReference Include="TypeMerger" Version="2.1.4" />
	</ItemGroup>
</Project>
